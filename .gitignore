# build output
main.js
dist/
*.js.map

# No longer produced: the binary is embedded into main.js as base64. Kept
# ignored so a stale copy from an older build is never committed.
/halyard-libgit2.wasm

# The compiled libgit2-WASM artifacts ARE committed, so consuming this repo
# needs no Docker/Emscripten. The `dist/` rule above would otherwise match them.
!src/git/libgit2/build/dist/
!src/git/libgit2/build/dist/**

# Build cache: large, machine-specific, regenerable.
src/git/libgit2/build/.build-work/

# dependencies
node_modules/

# environment / editor cruft
.DS_Store
Thumbs.db
.claude/

# Obsidian plugin runtime data (never commit tokens)
data.json

# wdio-obsidian-service: downloaded/cached real Obsidian builds for e2e tests
.obsidian-cache
