{
	"name": "tether-sync",
	"version": "0.1.3",
	"description": "Sync an Obsidian vault with a git repository over HTTPS on desktop and mobile.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"git",
		"sync"
	],
	"author": "timrs2998",
	"license": "MIT",
	"dependencies": {
		"buffer": "^6.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.0.0",
		"@wdio/cli": "^9.28.0",
		"@wdio/globals": "^9.28.0",
		"@wdio/local-runner": "^9.28.0",
		"@wdio/mocha-framework": "^9.28.0",
		"@wdio/spec-reporter": "^9.28.0",
		"builtin-modules": "^5.0.0",
		"chai": "^5.3.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"mocha": "^10.8.2",
		"obsidian": "^1.13.1",
		"tsx": "^4.22.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.0",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	}
}
